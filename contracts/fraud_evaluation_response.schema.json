{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devtrails.local/contracts/fraud_evaluation_response.schema.json",
  "title": "fraud_evaluation_response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "event_id",
    "evaluated_at",
    "results"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "worker_id",
          "frs_score",
          "decision"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "format": "uuid"
          },
          "worker_id": {
            "type": "string",
            "format": "uuid"
          },
          "frs_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "decision": {
            "type": "string",
            "enum": [
              "auto_approve",
              "partial_hold",
              "full_withhold"
            ]
          },
          "risk_flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
